# nginx.conf.template
#
# 作用：将 80 端口的 HTTP 请求反向代理到本机的 Next.js 服务（127.0.0.1:3000）。
# 使用方式（示例 Ubuntu）：
#   1) 将本文件复制为：/etc/nginx/sites-available/ai-hub.conf
#   2) ln -s /etc/nginx/sites-available/ai-hub.conf /etc/nginx/sites-enabled/ai-hub.conf
#   3) nginx -t && systemctl reload nginx

map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

server {
  listen 80;
  server_name _;

  # 视需要调整上传大小限制（如有大文件上传）
  client_max_body_size 20m;

  location / {
    proxy_pass http://127.0.0.1:3000;

    # Next.js / WebSocket / SSE 相关 header
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;

    # 透传客户端真实信息
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # 避免缓存升级相关问题
    proxy_cache_bypass $http_upgrade;

    # 适度的超时设置（长请求/流式输出可根据需要调大）
    proxy_read_timeout 60s;
    proxy_send_timeout 60s;
  }
}
