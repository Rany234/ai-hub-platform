generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 枚举定义
enum UserRole {
  buyer
  creator
  admin
}

enum ListingStatus {
  active
  inactive
  draft
  archived
}

enum OrderStatus {
  pending
  paid
  delivered
  completed
  disputed
}

enum EscrowStatus {
  held
  released
  refunded
}

enum PaymentMethod {
  STRIPE
  WECHAT
  ALIPAY
  OFFLINE
}

enum TransactionType {
  ORDER
  SALE_EARNING
  COMMISSION
}

enum ListingType {
  SERVICE
  ASSET
}

// 核心用户表 (NextAuth + 业务扩展)
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  password      String?

  inviteCode    String    @unique @default(cuid()) @map("invite_code")
  referredBy    String?   @map("referred_by")
  earningsBalance Float  @default(0) @map("earnings_balance")
  
  // 业务扩展字段
  username      String?
  fullName      String?   @map("full_name")
  avatarUrl     String?   @map("avatar_url") // deprecated: use image
  role          UserRole? @default(buyer)
  createdAt     DateTime  @default(now()) @map("created_at")

  // 自关联：推荐关系
  referrals User[] @relation("UserReferrals")
  referrer  User?  @relation("UserReferrals", fields: [referredBy], references: [id])

  // 关联
  accounts            Account[]
  sessions            Session[]
  listings            Listing[]           @relation("UserListings")
  orders              Order[]             @relation("UserOrders")
  manifestoSignatures ManifestoSignature[]
  transactions         Transaction[]

  @@index([referredBy])
  @@map("users")
}

// NextAuth 标准表
model Account {
  id                 String  @id @default(cuid())
  userId             String  @map("user_id")
  type               String
  provider           String
  providerAccountId  String  @map("provider_account_id")
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// 业务表：服务商品
model Listing {
  id          String        @id @default(cuid())
  creatorId   String        @map("creator_id")
  type        ListingType   @default(SERVICE)
  title       String
  description String?
  price       Float
  category    String?
  metadata    Json?         // 存储 base_model, credits 等灵活字段
  options     Json?
  previewUrl  String?       @map("preview_url")
  coverKey    String?       @map("cover_key")
  attachmentUrl String?     @map("attachment_url")
  instantDelivery Boolean   @default(false) @map("instant_delivery")

  parentId    String?       @map("parent_id")
  parent      Listing?      @relation("ListingRemix", fields: [parentId], references: [id])
  children    Listing[]     @relation("ListingRemix")
  royaltyRate Float         @default(0.10) @map("royalty_rate")
  isRemix     Boolean       @default(false) @map("is_remix")

  status      ListingStatus? @default(active)
  createdAt   DateTime      @default(now()) @map("created_at")

  creator User @relation("UserListings", fields: [creatorId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@index([creatorId])
  @@index([type])
  @@index([parentId])
  @@map("listings")
}

// 业务表：订单
model Order {
  id               String        @id @default(cuid())
  buyerId          String        @map("buyer_id")
  listingId        String        @map("listing_id")
  amount           Float
  status           OrderStatus   @default(pending)
  metadata         Json?
  escrowStatus     EscrowStatus  @default(held) @map("escrow_status")
  paymentMethod    PaymentMethod @default(OFFLINE) @map("payment_method")
  paymentChannelId String?       @map("payment_channel_id")
  createdAt        DateTime      @default(now()) @map("created_at")

  deliveries   Delivery[]
  buyer   User    @relation("UserOrders", fields: [buyerId], references: [id])
  listing Listing @relation(fields: [listingId], references: [id])
  transactions Transaction[]

  @@index([buyerId])
  @@index([listingId])
  @@map("orders")
}

// 业务表：共生宣言签署记录
model ManifestoSignature {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  signatureHash String   @map("signature_hash")
  signedAt      DateTime @default(now()) @map("signed_at")
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@map("manifesto_signatures")
}

// 新增：交付记录表
model Delivery {
  id          String   @id @default(cuid())
  orderId     String   @map("order_id")
  content     String?
  fileUrl     String?  @map("file_url")
  fileKey     String?  @map("file_key")
  fileSize    Int?     @map("file_size")
  fileType    String?  @map("file_type")
  fileName    String?  @map("file_name")
  status      String   @default("pending")
  createdAt   DateTime @default(now()) @map("created_at")

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("deliveries")
}

model Transaction {
  id        String          @id @default(cuid())
  type      TransactionType @default(ORDER)
  amount    Float

  orderId   String? @map("order_id")
  order     Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  beneficiaryId String @map("beneficiary_id")
  beneficiary   User   @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([type])
  @@index([orderId])
  @@index([beneficiaryId])
  @@map("transactions")
}
