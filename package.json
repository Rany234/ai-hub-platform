{
  "name": "ai-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint",
    "db:reset": "node scripts/db-reset.js",
    "db:seed": "npx prisma db seed",
    "prisma:refresh": "node -e \"const fs=require('fs'); const paths=['.next','node_modules/.prisma']; for (const p of paths) { try { fs.rmSync(p,{ recursive:true, force:true }); } catch(e) {} }\" && npx prisma generate",
    "local:verify": "node scripts/local-verify.js",
    "local:verify:session": "node scripts/local-verify.js --check-session",
    "verify:settlement:idempotency": "tsx scripts/verify-settlement-idempotency.js",
    "verify:settlement:ide": "node scripts/verify-settlement-suite.js"
  },
  "prisma": {
    "seed": "ts-node -P tsconfig.json prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "@stripe/stripe-js": "^8.7.0",
    "@tailwindcss/typography": "^0.5.19",
    "@xyflow/react": "^12.10.1",
    "ali-oss": "^6.23.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.31.1",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "next-auth": "^5.0.0-beta.30",
    "pg": "^8.18.0",
    "pm2": "^6.0.14",
    "proxy-agent": "^5.0.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "react-markdown": "^10.1.0",
    "reactflow": "^11.11.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "stripe": "^20.3.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@prisma/config": "^7.4.0",
    "@tailwindcss/postcss": "^4",
    "@types/dagre": "^0.7.53",
    "@types/node": "^20.19.33",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^7.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
